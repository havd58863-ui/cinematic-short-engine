# Optional overrides. OmniRoute API key or custom scriptwriter command can be used.
RESEARCH_REGION=us-en
DEFAULT_VIDEO_SECONDS=45
TIKTOK_OUTPUT_ROOT=jobs
TIKTOK_MODEL_CACHE=model_cache
OMNIROUTE_API_KEY=
OMNIROUTE_BASE_URL=https://omniroute.online/v1/chat/completions
OMNIROUTE_MODEL=gpt-4o-mini
# Existing writer adapter: command must accept --prompt-file PATH --output-file PATH.
# SCRIPTWRITER_COMMAND=python /absolute/path/to/existing_writer.py
ENABLE_REAL_IMAGE_TO_VIDEO=true
ENABLE_IP_ADAPTER=false
ALLOW_CPU_IMAGE_GENERATION=false
KOKORO_VOICE=af_heart
WHISPER_MODEL=base.en
# Optional stock fallback: store these only in Colab Secrets or local environment, never in Git.
PIXABAY_API_KEY=
PEXELS_API_KEY=
# Optional secondary search-interest signal, not TikTok analytics.
ENABLE_PYTRENDS=false
