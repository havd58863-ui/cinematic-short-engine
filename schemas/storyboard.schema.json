{
  "$defs": {
    "Shot": {
      "properties": {
        "shot_id": {
          "minLength": 1,
          "title": "Shot Id",
          "type": "string"
        },
        "sequence_number": {
          "minimum": 1,
          "title": "Sequence Number",
          "type": "integer"
        },
        "start_seconds": {
          "minimum": 0,
          "title": "Start Seconds",
          "type": "number"
        },
        "end_seconds": {
          "exclusiveMinimum": 0,
          "title": "End Seconds",
          "type": "number"
        },
        "narration": {
          "minLength": 1,
          "title": "Narration",
          "type": "string"
        },
        "purpose": {
          "minLength": 1,
          "title": "Purpose",
          "type": "string"
        },
        "visual_prompt": {
          "minLength": 12,
          "title": "Visual Prompt",
          "type": "string"
        },
        "negative_prompt": {
          "minLength": 1,
          "title": "Negative Prompt",
          "type": "string"
        },
        "shot_size": {
          "default": "medium close-up",
          "title": "Shot Size",
          "type": "string"
        },
        "camera_angle": {
          "default": "eye level",
          "title": "Camera Angle",
          "type": "string"
        },
        "camera_movement": {
          "default": "slow push-in",
          "title": "Camera Movement",
          "type": "string"
        },
        "subject_movement": {
          "default": "subtle natural movement",
          "title": "Subject Movement",
          "type": "string"
        },
        "environmental_movement": {
          "default": "subtle atmospheric motion",
          "title": "Environmental Movement",
          "type": "string"
        },
        "composition": {
          "default": "vertical 9:16; keep the subject and essential details inside central safe area",
          "title": "Composition",
          "type": "string"
        },
        "lighting": {
          "default": "motivated cinematic lighting",
          "title": "Lighting",
          "type": "string"
        },
        "palette": {
          "default": "consistent restrained color palette",
          "title": "Palette",
          "type": "string"
        },
        "atmosphere": {
          "default": "cinematic, grounded",
          "title": "Atmosphere",
          "type": "string"
        },
        "depth_of_field": {
          "default": "shallow when it supports story clarity",
          "title": "Depth Of Field",
          "type": "string"
        },
        "reference_assets": {
          "items": {
            "type": "string"
          },
          "title": "Reference Assets",
          "type": "array"
        },
        "continuity_notes": {
          "default": "Maintain subject identity, wardrobe, lighting direction, object position, and screen direction.",
          "title": "Continuity Notes",
          "type": "string"
        },
        "sound_cues": {
          "items": {
            "type": "string"
          },
          "title": "Sound Cues",
          "type": "array"
        },
        "transition": {
          "default": "cut on action",
          "title": "Transition",
          "type": "string"
        },
        "subtitle_text": {
          "default": "",
          "title": "Subtitle Text",
          "type": "string"
        },
        "subtitle_start_seconds": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subtitle Start Seconds"
        },
        "subtitle_end_seconds": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subtitle End Seconds"
        },
        "image_model": {
          "default": "stabilityai/stable-diffusion-xl-base-1.0",
          "title": "Image Model",
          "type": "string"
        },
        "image_settings": {
          "additionalProperties": true,
          "title": "Image Settings",
          "type": "object"
        },
        "video_model": {
          "default": "auto",
          "title": "Video Model",
          "type": "string"
        },
        "video_settings": {
          "additionalProperties": true,
          "title": "Video Settings",
          "type": "object"
        },
        "image_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Image Path"
        },
        "video_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Video Path"
        },
        "video_method": {
          "default": "not_generated",
          "enum": [
            "not_generated",
            "neural_image_to_video",
            "ffmpeg_animation"
          ],
          "title": "Video Method",
          "type": "string"
        },
        "generation_status": {
          "default": "pending",
          "title": "Generation Status",
          "type": "string"
        },
        "generation_error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Generation Error"
        }
      },
      "required": [
        "shot_id",
        "sequence_number",
        "start_seconds",
        "end_seconds",
        "narration",
        "purpose",
        "visual_prompt",
        "negative_prompt"
      ],
      "title": "Shot",
      "type": "object"
    }
  },
  "properties": {
    "title": {
      "title": "Title",
      "type": "string"
    },
    "target_audience": {
      "default": "US TikTok viewers",
      "title": "Target Audience",
      "type": "string"
    },
    "aspect_ratio": {
      "default": "9:16",
      "title": "Aspect Ratio",
      "type": "string"
    },
    "target_duration_seconds": {
      "default": 45,
      "title": "Target Duration Seconds",
      "type": "number"
    },
    "visual_identity": {
      "default": "",
      "title": "Visual Identity",
      "type": "string"
    },
    "shots": {
      "items": {
        "$ref": "#/$defs/Shot"
      },
      "title": "Shots",
      "type": "array"
    },
    "character_reference_required": {
      "default": false,
      "title": "Character Reference Required",
      "type": "boolean"
    }
  },
  "required": [
    "title",
    "shots"
  ],
  "title": "Storyboard",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
