{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TikTok AIDirector Job Manifest",
  "type": "object",
  "required": [
    "job_id",
    "created_at_utc",
    "status",
    "settings"
  ],
  "properties": {
    "job_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "topic": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "running",
        "success",
        "partial_success",
        "failed"
      ]
    },
    "current_stage": {
      "type": "string"
    },
    "stages": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "enum": [
              "running",
              "success",
              "partial_success",
              "failed",
              "warning",
              "unavailable"
            ]
          },
          "updated_at_utc": {
            "type": "string"
          },
          "details": {
            "type": "object"
          }
        }
      }
    },
    "settings": {
      "type": "object"
    },
    "final_video": {
      "type": "string"
    },
    "video_methods": {
      "type": "object",
      "additionalProperties": {
        "enum": [
          "neural_image_to_video",
          "ffmpeg_animation"
        ]
      }
    },
    "failure": {
      "type": "object"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}